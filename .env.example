# PULSE Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./pulse.db
SQL_ECHO=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server
HOST=127.0.0.1
PORT=8000

# Future Integration Placeholders (Do not commit real tokens or credentials)
TALKDESK_API_BASE_URL=https://api.talkdeskapp.com
TALKDESK_API_KEY=
TALKDESK_ACCOUNT_ID=

